<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>0.2.0</Version>
    <PackageId>Codeer.LowCode.Blazor.DbAccess</PackageId>
    <Title>Codeer.LowCode.Blazor.DbAccess</Title>
    <Company>Codeer</Company>
    <Authors>Codeer</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Manual</PackageProjectUrl>
    <PackageTags>Blazor;LowCode;Codeer;Database</PackageTags>
    <Description>Multi-database access layer (SQL Server / PostgreSQL / Oracle / SQLite / MySQL) for Codeer.LowCode.Blazor server applications. Provides the standard IDbAccessor implementation (Dapper based, overridable). Note: the Oracle provider (Oracle.ManagedDataAccess.Core) is licensed under the Oracle Free Use Terms and Conditions.</Description>
    <PackageIcon>IconNuget.png</PackageIcon>
    <PackageReleaseNotes>DbAccessor.CommandTimeoutSeconds: SQL command timeout applied to every command on the connection (0 = driver default). Requires Codeer.LowCode.Blazor 1.3.41.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\IconNuget.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Codeer.LowCode.Blazor" Version="1.3.41" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Npgsql" Version="8.0.8" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.7.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.8" />
    <PackageReference Include="Dapper" Version="2.1.35" />
  </ItemGroup>
</Project>
